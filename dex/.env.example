# Copy this file to .env and fill in your own value. Never commit the real
# .env file - it's already covered by the root .gitignore.

# Sepolia RPC endpoint used for reading swap/transaction history directly
# from the chain. Get a free project URL at infura.io (or use Alchemy).
REACT_APP_INFURA_URL=

# Base URL of the deployed dexBack server (e.g. https://your-app.onrender.com).
# Leave blank for local dev - apiConfig.js falls back to http://localhost:3001.
REACT_APP_API_URL=
