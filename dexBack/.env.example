# Copy this file to .env and fill in your own keys. Never commit the real
# .env file - it's already covered by the root .gitignore.

# Free CoinGecko "Demo" API key (no card needed) - sign up at coingecko.com.
# Powers live token prices and the price chart. Falls back to mock prices if
# missing or unreachable.
COINGECKO_API_KEY=

# Free key at aistudio.google.com -> Get API key (no card required). Powers
# the AI Assistant page (/assistant). Without this set, the assistant falls
# back to its small built-in local FAQ instead of erroring.
GEMINI_API_KEY=

# Optional - override the Gemini model used (default: gemini-flash-lite-latest).
# GEMINI_MODEL=gemini-flash-lite-latest
