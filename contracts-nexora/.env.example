# Copy this file to .env and fill in your own values. Never commit the real
# .env file - it's covered by .gitignore.

# Your wallet's private key, used ONLY to sign Sepolia testnet transactions
# (deploying the 4 token contracts, creating pools, seeding liquidity).
# This never leaves your machine and is never sent anywhere by these scripts.
PRIVATE_KEY=

# Optional - defaults to a public Sepolia RPC if left blank (same one dex/.env
# already uses). Set your own Infura/Alchemy URL here if you have one.
SEPOLIA_RPC_URL=

# How much test USDC (whole units, not wei) to seed into EACH of the 4 new
# pools. The matching amount of the new token is computed automatically from
# its target price so the pool opens at the right ratio. Get test USDC from
# https://faucet.circle.com first.
LIQUIDITY_USDC_PER_POOL=10
